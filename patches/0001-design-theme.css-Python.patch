+  /* semantic: target status (미달 / 충족 / 초과) — also used for 매수 / 매도 */
+  --under: #276893;       --under-soft: #e6f0f8;   --under-line: #5b9dc9;
+  --met: #387762;         --met-soft: #e3f0e9;     --met-line: #75af8d;
+  --over: #ad5146;        --over-soft: #fae8e3;    --over-line: #d67969;
+  --wait: #72695f;        --wait-soft: #eee9e1;
+  /* rule preview on deep surface */
+  --code-signal: #f2aa7d; --code-number: #9bd1ee;  --code-pass: #9de0b9; --code-fail: #f6aaa0;
+
+  /* type scale (rem @16px) */
+  --fs-2xs: .7rem; --fs-xs: .76rem; --fs-sm: .84rem; --fs-md: .92rem; --fs-lg: 1.05rem;
+  --fs-xl: 1.3rem; --fs-2xl: 1.9rem;
+  --fw-medium: 600; --fw-semibold: 680; --fw-bold: 760; --fw-heavy: 800;
+  --tracking-caps: .13em;
+  --font: Pretendard, "Pretendard Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", sans-serif;
+  /* spacing (4px grid) */
+  --sp-1: .25rem; --sp-2: .5rem; --sp-3: .75rem; --sp-4: 1rem; --sp-5: 1.25rem; --sp-6: 1.5rem;
+  /* radius */
+  --r-sm: 10px; --r-md: 12px; --r-lg: 14px; --r-xl: 16px; --r-pill: 999px;
+  /* elevation */
+  --shadow-1: 0 1px 2px rgba(41,45,42,.06);
+  --shadow-2: 0 6px 18px -14px rgba(38,61,51,.45);
+  --shadow-accent: 0 8px 18px -10px var(--accent);
+  --focus-ring: 0 0 0 3px var(--accent-soft);
+  /* touch */
+  --tap: 44px; --tap-lg: 50px;
+
+  /* legacy aliases (kept so older markup keeps working) */
+  --warm-bg: var(--bg); --warm-surface: var(--surface); --warm-ink: var(--ink); --warm-muted: var(--muted);
+  --warm-border: var(--line); --terracotta: var(--accent); --terracotta-dark: var(--accent-strong);
+  --terracotta-soft: var(--accent-soft); --deep-green: var(--deep); --terminal-info: var(--under); --terminal-red: var(--over);
