diff --git a/streamlit_app/theme.css b/streamlit_app/theme.css
index 6067915..b0e4ce4 100644
--- a/streamlit_app/theme.css
+++ b/streamlit_app/theme.css
@@ -206,3 +206,24 @@ p, li { line-height: 1.55; }
 @media (max-width: 800px) {
   .stSelectbox [data-baseweb="select"] > div:first-child, .stMultiSelect [data-baseweb="select"] > div:first-child { border: 1px solid var(--warm-border) !important; background-color: #fff !important; border-radius: 12px !important; min-height: 46px; }
 }
+@media (max-width: 800px) {
+  /* Streamlit 1.5x+ select box (react-aria / baseweb) */
+  .stSelectbox .react-aria-ComboBox > div[role], .stMultiSelect .react-aria-ComboBox > div[role],
+  .stSelectbox [data-baseweb="select"] > div:first-child, .stMultiSelect [data-baseweb="select"] > div:first-child { border: 1px solid var(--warm-border) !important; background-color: #fff !important; border-radius: 12px !important; min-height: 46px; }
+  .stSelectbox .react-aria-ComboBox > div[role]:focus-within { border-color: var(--terracotta) !important; box-shadow: 0 0 0 3px var(--terracotta-soft); }
+  .st-key-mobile_toolbar .stSelectbox .react-aria-ComboBox > div[role], .st-key-mobile_toolbar [data-testid="stDateInputField"] { background-color: var(--warm-bg) !important; }
+}
+@media (max-width: 800px) {
+  /* target-status filter: one scrollable row of compact chips */
+  .st-key-order_target_filter [role="radiogroup"] { flex-wrap: nowrap !important; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
+  .st-key-order_target_filter [role="radiogroup"]::-webkit-scrollbar { display: none; }
+  .st-key-order_target_filter [role="radiogroup"] label { flex: 0 0 auto; min-height: 40px; padding: .3rem .8rem; }
+  .st-key-order_target_filter [role="radiogroup"] label > div:first-child { display: none; }
+  [data-testid="stPlotlyChart"] { background: var(--warm-surface); border: 1px solid var(--warm-border); border-radius: 14px; padding: .5rem .6rem .2rem; }
+  /* horizontal radios (집계 기준 등) as segmented chips */
+  .stRadio [role="radiogroup"][aria-orientation="horizontal"], .stRadio div[role="radiogroup"] { gap: .35rem; }
+}
+@media (max-width: 800px) {
+  .st-key-order_target_filter [role="radiogroup"] label p, .st-key-order_target_filter [role="radiogroup"] label [data-testid="stMarkdownContainer"] { white-space: nowrap !important; display: inline; }
+  .st-key-order_target_filter [role="radiogroup"] label [data-testid="stMarkdownContainer"] p br { display: none; }
+}
